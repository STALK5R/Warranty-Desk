{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "warranty-desk",
  "main": "worker/index.ts",
  "compatibility_date": "2026-04-01",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {"directory": "./dist", "binding": "ASSETS", "run_worker_first": true, "not_found_handling": "single-page-application"},
  "d1_databases": [{"binding": "DB", "database_name": "warranty-desk", "database_id": "B7bef117-b544-4047-94a5-87b350fea085", "migrations_dir": "migrations"}],
  "r2_buckets": [{"binding": "BUCKET", "bucket_name": "warranty-desk-contracts"}],
  "vars": {"OPENAI_MODEL": "gpt-4.1-mini"},
  "ratelimits": [
    {"name": "LOGIN_LIMITER", "namespace_id": "1001", "simple": {"limit": 10, "period": 60}},
    {"name": "AI_LIMITER", "namespace_id": "1002", "simple": {"limit": 10, "period": 60}}
  ]
}
